temperature = int(input())
ac_on = False
if temperature > 80:
    if not ac_on:
        ac_on = True
        print("turn AC on")
    else:
        print("no action required")
elif temperature < 80:
    if not ac_on:
        ac_on = True
        print("turn ac off")
    else:
        print("no action required")
